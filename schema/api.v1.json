{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UGClient sidecar API",
  "version": "1.0",
  "description": "JSON-RPC 2.0 over ws://127.0.0.1:<port>. Units: mm, deg, kg, N·m, s. Pose defaults to TCP (flange ∘ TCP offset). See docs/DESIGN.md §5.",
  "methods": {
    "system.hello": {
      "params": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "api_version": {
            "type": "string"
          },
          "client_version": {
            "type": "string"
          }
        },
        "required": [
          "token"
        ]
      }
    },
    "system.shutdown": {
      "params": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    "ping": {
      "params": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    "robot.list": {
      "params": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    "robot.info": {
      "params": {
        "type": "object",
        "properties": {
          "robot": {
            "type": "string"
          },
          "end_effector": {
            "type": "string"
          }
        },
        "required": [
          "robot"
        ]
      }
    },
    "robot.load": {
      "params": {
        "type": "object",
        "properties": {
          "robot": {
            "type": "string"
          },
          "end_effector": {
            "type": "string"
          },
          "calibration": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "required": [
          "robot"
        ]
      }
    },
    "tcp.set": {
      "params": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "offset": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 6,
            "maxItems": 6,
            "description": "[x,y,z mm, roll,pitch,yaw deg], fixed-axis XYZ"
          }
        },
        "required": [
          "session_id",
          "offset"
        ]
      }
    },
    "payload.set": {
      "params": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "mass_kg": {
            "type": "number",
            "minimum": 0
          },
          "com_mm": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "inertia_kgm2": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "number"
            },
            "minItems": 6,
            "maxItems": 6
          }
        },
        "required": [
          "session_id",
          "mass_kg",
          "com_mm"
        ]
      }
    },
    "kin.fk": {
      "params": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "q_deg": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "joint angles in degrees, length = dof"
          },
          "frames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "session_id",
          "q_deg"
        ]
      }
    },
    "kin.ik": {
      "params": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "target_pose": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 6,
            "maxItems": 6,
            "description": "[x,y,z mm, roll,pitch,yaw deg], fixed-axis XYZ"
          },
          "frame": {
            "enum": [
              "tcp",
              "flange"
            ]
          },
          "seed_q_deg": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "joint angles in degrees, length = dof"
          },
          "mode": {
            "enum": [
              "nearest",
              "all"
            ]
          },
          "tol_mm": {
            "type": "number"
          },
          "tol_deg": {
            "type": "number"
          }
        },
        "required": [
          "session_id",
          "target_pose"
        ]
      }
    },
    "kin.jacobian": {
      "params": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "q_deg": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "joint angles in degrees, length = dof"
          },
          "frame": {
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "q_deg"
        ]
      }
    },
    "dyn.gravity": {
      "params": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "q_deg": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "joint angles in degrees, length = dof"
          }
        },
        "required": [
          "session_id",
          "q_deg"
        ]
      }
    },
    "dyn.rnea": {
      "params": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "q_deg": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "joint angles in degrees, length = dof"
          },
          "qd_dps": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "joint angles in degrees, length = dof"
          },
          "qdd_dps2": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "joint angles in degrees, length = dof"
          }
        },
        "required": [
          "session_id",
          "q_deg",
          "qd_dps",
          "qdd_dps2"
        ]
      }
    },
    "dyn.mass_matrix": {
      "params": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "q_deg": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "joint angles in degrees, length = dof"
          }
        },
        "required": [
          "session_id",
          "q_deg"
        ]
      }
    },
    "check.pose": {
      "params": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "target_pose": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 6,
            "maxItems": 6,
            "description": "[x,y,z mm, roll,pitch,yaw deg], fixed-axis XYZ"
          },
          "frame": {
            "enum": [
              "tcp",
              "flange"
            ]
          },
          "seed_q_deg": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "joint angles in degrees, length = dof"
          }
        },
        "required": [
          "session_id",
          "target_pose"
        ]
      }
    },
    "motion.jog_tcp": {
      "description": "Simulation only. One base-frame TCP increment from q_deg (nearest IK). Returns {q_deg, tcp_pose}. Errors 3001 unreachable / large joint jump, 3003 joint limit.",
      "params": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "q_deg": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "joint angles in degrees, length = dof"
          },
          "axis": {
            "enum": [
              "x",
              "y",
              "z",
              "roll",
              "pitch",
              "yaw"
            ]
          },
          "delta": {
            "type": "number",
            "description": "mm for x/y/z, deg for roll/pitch/yaw (rotation about the base axis)"
          }
        },
        "required": [
          "session_id",
          "q_deg",
          "axis",
          "delta"
        ]
      }
    },
    "motion.align": {
      "description": "Simulation only. Move only the last three joints so the tool z-axis points straight down (roll 180, pitch 0, current yaw); TCP position may change. Returns {q_deg, tcp_pose}. Error 3001 if unreachable.",
      "params": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "q_deg": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "joint angles in degrees, length = dof"
          }
        },
        "required": [
          "session_id",
          "q_deg"
        ]
      }
    },
    "real.connect": {
      "description": "Connect to a physical UFACTORY controller, verify (axis, device_type), and read live motor enable state.",
      "params": {
        "type": "object",
        "properties": {
          "ip": {
            "type": "string",
            "default": "192.168.1.60"
          },
          "robot": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": []
      }
    },
    "real.disconnect": {
      "description": "Stop active motion and disconnect from the physical controller.",
      "params": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    "real.status": {
      "description": "Return the latest physical controller snapshot.",
      "params": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    "real.enable": {
      "description": "Explicitly enable or disable physical robot motion. Refuses if error_code != 0.",
      "params": {
        "type": "object",
        "properties": {
          "enable": {
            "type": "boolean"
          }
        },
        "required": [
          "enable"
        ]
      }
    },
    "real.clear_error": {
      "description": "Explicit user-triggered clean_warn + clean_error on the physical controller.",
      "params": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    "real.stop": {
      "description": "Fast-path stop (set_state(6) deceleration stop when decel=true, set_state(4) immediate stop by default, or emergency_stop when emergency=true).",
      "params": {
        "type": "object",
        "properties": {
          "emergency": {
            "type": "boolean"
          },
          "decel": {
            "type": "boolean"
          }
        },
        "required": []
      }
    },
    "real.step_joint": {
      "description": "Single-click joint step in Mode 0 with safety boundary pre-check.",
      "params": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "delta_deg": {
            "type": "number"
          },
          "speed_dps": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "boundary": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "required": [
          "index",
          "delta_deg"
        ]
      }
    },
    "real.step_tcp": {
      "description": "Single-click base-frame TCP step in Mode 0 with safety boundary pre-check.",
      "params": {
        "type": "object",
        "properties": {
          "axis": {
            "enum": [
              "x",
              "y",
              "z",
              "roll",
              "pitch",
              "yaw"
            ]
          },
          "delta": {
            "type": "number"
          },
          "speed_mms": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "boundary": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "required": [
          "axis",
          "delta"
        ]
      }
    },
    "real.move_joints": {
      "description": "Move physical arm joints toward a target configuration in Mode 0 (Home / Align).",
      "params": {
        "type": "object",
        "properties": {
          "q_deg": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "speed_dps": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "boundary": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "required": [
          "q_deg"
        ]
      }
    },
    "real.jog_joint_vel": {
      "description": "Continuous joint velocity jog in Mode 4 with hardware duration and sidecar watchdog.",
      "params": {
        "type": "object",
        "properties": {
          "speeds_dps": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "duration_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "boundary": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "required": [
          "speeds_dps"
        ]
      }
    },
    "real.jog_tcp_vel": {
      "description": "Continuous base-frame TCP velocity jog in Mode 5 with hardware duration and sidecar watchdog.",
      "params": {
        "type": "object",
        "properties": {
          "speeds": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 6,
            "maxItems": 6
          },
          "duration_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "boundary": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "required": [
          "speeds"
        ]
      }
    },
    "real.set_tcp": {
      "description": "Write TCP offset [x,y,z mm, r,p,y deg] to the physical controller while stationary.",
      "params": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 6,
            "maxItems": 6
          }
        },
        "required": [
          "offset"
        ]
      }
    },
    "real.set_payload": {
      "description": "Write payload mass (kg) and flange-frame COM (mm) to the physical controller while stationary.",
      "params": {
        "type": "object",
        "properties": {
          "mass_kg": {
            "type": "number",
            "minimum": 0
          },
          "com_mm": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "required": [
          "mass_kg",
          "com_mm"
        ]
      }
    }
  },
  "errors": {
    "1001": "AUTH_FAILED",
    "1002": "API_VERSION_MISMATCH",
    "2001": "ROBOT_NOT_FOUND",
    "2002": "SESSION_NOT_FOUND",
    "2003": "ASSET_ERROR",
    "2004": "CALIBRATION_INVALID",
    "3001": "IK_UNREACHABLE",
    "3002": "IK_NOT_CONVERGED",
    "3003": "JOINT_LIMIT",
    "3004": "SINGULAR",
    "4001": "JOB_CANCELLED",
    "5001": "BACKEND_UNAVAILABLE",
    "6001": "REAL_NOT_CONNECTED",
    "6002": "REAL_CONNECT_FAILED",
    "6003": "REAL_MODEL_MISMATCH",
    "6004": "REAL_CONTROLLER_ERROR",
    "6005": "REAL_MOTION_REJECTED",
    "6006": "REAL_SDK_UNAVAILABLE"
  }
}
